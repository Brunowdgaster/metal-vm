; soma 1..100 com locais e salto condicional
.entry main
main:
  RESERVE 2         ; slot0 = i, slot1 = soma
  PUSH 1
  STORE 0
  PUSH 0
  STORE 1
loop:
  LOAD 0
  PUSH 100
  GT
  JNZ fim
  LOAD 1
  LOAD 0
  ADD
  STORE 1
  LOAD 0
  PUSH 1
  ADD
  STORE 0
  JMP loop
fim:
  LOAD 1
  PRINT             ; 5050
  HALT
